{
  "openapi": "3.0.3",
  "info": {
    "title": "MindMantra Live API",
    "description": "RESTful API for MindMantra learning platform providing authentication, course catalogs, and multiple choice question (MCQ) assessments.",
    "version": "1.0.0",
    "contact": {
      "name": "MindMantra Team",
      "url": "https://mindmantra.live"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.mindmantra.live",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "summary": "Register a new user",
        "description": "Create a new user account with email and password. Returns session token and user profile.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Email already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "Authenticate an existing user with email and password. Sets an HTTP-only session cookie and returns a bearer token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Account disabled"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Log out user",
        "description": "Terminate the current session and clear authentication cookies.",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    },
    "/api/v1/courses": {
      "get": {
        "summary": "List published courses",
        "description": "Retrieve a paginated list of published courses with optional filtering by category or keyword search.",
        "tags": ["Courses"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of courses per page (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by course category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search term matching title or description",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated course list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{identifier}": {
      "get": {
        "summary": "Get course details",
        "description": "Retrieve comprehensive details of a single course by its numeric ID or unique slug.",
        "tags": ["Courses"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Course numeric ID or URL slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/v1/courses/{identifier}/mcqs": {
      "get": {
        "summary": "List MCQs for a course",
        "description": "Retrieve paginated Multiple Choice Questions (MCQs) associated with a given course.",
        "tags": ["Courses", "MCQs"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Course numeric ID or URL slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of questions per page (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated MCQs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseMcqResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "List user notifications",
        "description": "Retrieve paginated list of notifications for the authenticated user, including unread count.",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 15 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["unread", "read", "all"], "default": "all" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of notifications",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationListResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/notifications/unread-count": {
      "get": {
        "summary": "Get unread notifications badge count",
        "description": "Fast endpoint returning the number of unread notifications for the user.",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Unread count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "example": 200 },
                    "success": { "type": "boolean", "example": true },
                    "unread_count": { "type": "integer", "example": 3 }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/notifications/{id}": {
      "get": {
        "summary": "Get single notification details",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Notification details" },
          "404": { "description": "Notification not found" }
        }
      },
      "delete": {
        "summary": "Delete a notification",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Notification deleted successfully" },
          "404": { "description": "Notification not found" }
        }
      }
    },
    "/api/v1/notifications/{id}/read": {
      "post": {
        "summary": "Mark notification as read",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Marked as read successfully" }
        }
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "summary": "Mark all notifications as read",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "All notifications marked as read" }
        }
      }
    },
    "/api/v1/notifications/devices/register": {
      "post": {
        "summary": "Register or update FCM device token",
        "description": "Registers device push token for mobile/web push notifications. Automatically binds to logged-in user if token is supplied.",
        "tags": ["Notifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeviceRegisterRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Device registered successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/notifications/devices/unregister": {
      "post": {
        "summary": "Unregister FCM device token",
        "tags": ["Notifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Device token unregistered successfully" }
        }
      }
    },
    "/api/v1/notifications/send": {
      "post": {
        "summary": "Send notification to a specific user",
        "description": "Stores an in-app notification and dispatches a push notification to all active devices of the target user.",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendNotificationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Notification dispatched" },
          "403": { "description": "Admin privileges required" }
        }
      }
    },
    "/api/v1/notifications/broadcast": {
      "post": {
        "summary": "Broadcast notification to all users",
        "description": "Admin endpoint to send push notification to all active devices and store global announcement.",
        "tags": ["Notifications"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BroadcastNotificationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Broadcast dispatched successfully" },
          "403": { "description": "Admin privileges required" }
        }
      }
    },
    "/api/v1/notifications/test-push": {
      "post": {
        "summary": "Test push dispatch to a specific FCM token",
        "tags": ["Notifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" },
                  "title": { "type": "string" },
                  "body": { "type": "string" },
                  "data": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Test push dispatched" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mm_user_session"
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "example": "StrongPass123!"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPass123!"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "email": { "type": "string", "example": "student@example.com" },
          "name": { "type": "string", "example": "Student" },
          "picture": { "type": "string", "example": "" },
          "googleId": { "type": "string", "example": "" },
          "role": { "type": "string", "example": "user" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/UserProfile" },
          "token": { "type": "string", "example": "eyJpZCI6IjEi...sig" }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1000004 },
          "slug": { "type": "string", "example": "upsssc-pet-2026" },
          "title": { "type": "string", "example": "UPSSSC PET 2026" },
          "description": { "type": "string", "example": "Comprehensive preparation course for UPSSSC PET exam." },
          "thumbnail": { "type": "string", "example": "https://example.com/thumb.jpg" },
          "time_limit": { "type": "integer", "example": 120 },
          "total_marks": { "type": "integer", "example": 100 },
          "total_questions": { "type": "integer", "example": 100 },
          "negative_marking": { "type": "number", "example": 0.25 },
          "is_published": { "type": "integer", "example": 1 },
          "category": { "type": "string", "example": "Government Exams" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "MCQ": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 32 },
          "question_text": { "type": "string", "example": "Who was the founder of the Maurya dynasty?" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Vijayalaya", "Chandragupta Maurya", "Sri Gupta", "Simuka"]
          },
          "correct_answer": { "type": "integer", "description": "Index of the correct option (0-based)", "example": 1 },
          "image_url": { "type": "string", "nullable": true, "example": null },
          "subject": { "type": "string", "example": "History" },
          "year": { "type": "integer", "nullable": true, "example": 2024 }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "per_page": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "example": 25 },
          "total_pages": { "type": "integer", "example": 3 }
        }
      },
      "CourseListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Course" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "CourseDetailResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Course" }
        }
      },
      "CourseMcqResponse": {
        "type": "object",
        "properties": {
          "course": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1000004 },
              "slug": { "type": "string", "example": "upsssc-pet-2026" },
              "title": { "type": "string", "example": "UPSSSC PET 2026" }
            }
          },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MCQ" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "user_id": { "type": "integer", "nullable": true, "example": 1 },
          "title": { "type": "string", "example": "New Mock Test Available" },
          "body": { "type": "string", "example": "A new mock test for UPSSSC PET 2026 is now live." },
          "type": { "type": "string", "example": "course" },
          "data": { "type": "object", "nullable": true, "example": { "course_id": 1000004, "screen": "quiz" } },
          "image_url": { "type": "string", "nullable": true, "example": "https://mindmantra.live/images/banner.jpg" },
          "is_read": { "type": "integer", "example": 0 },
          "read_at": { "type": "string", "format": "date-time", "nullable": true, "example": null },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-10-16 12:00:00" }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "example": 200 },
          "success": { "type": "boolean", "example": true },
          "unread_count": { "type": "integer", "example": 3 },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Notification" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "DeviceRegisterRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "description": "FCM Device Token", "example": "fcm_token_sample_string_12345" },
          "platform": { "type": "string", "enum": ["android", "ios", "web"], "default": "android", "example": "android" },
          "device_id": { "type": "string", "nullable": true, "example": "a1b2c3d4-e5f6-7890" },
          "device_name": { "type": "string", "nullable": true, "example": "Samsung Galaxy S23" }
        }
      },
      "SendNotificationRequest": {
        "type": "object",
        "required": ["user_id", "title", "body"],
        "properties": {
          "user_id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Important Exam Update" },
          "body": { "type": "string", "example": "Your test report is ready to download." },
          "type": { "type": "string", "default": "general", "example": "alert" },
          "data": { "type": "object", "example": { "url": "/reports/123" } },
          "image_url": { "type": "string", "nullable": true, "example": null }
        }
      },
      "BroadcastNotificationRequest": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "example": "Diwali Offer - 50% Off All Courses!" },
          "body": { "type": "string", "example": "Use code FESTIVE50 to enroll in premium test series today." },
          "type": { "type": "string", "default": "announcement", "example": "announcement" },
          "data": { "type": "object", "example": { "coupon": "FESTIVE50" } },
          "image_url": { "type": "string", "nullable": true, "example": "https://mindmantra.live/assets/festive.png" }
        }
      }
    }
  }
}

