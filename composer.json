{
    "name": "mindmantra/live-api",
    "description": "MindMantra Live API",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-fileinfo": "Improves mime type detection for files",
        "ext-mysqli": "If you use MySQL",
        "ext-sodium": "If you use Encryption SodiumHandler"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\": "system/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
