#--------------------------------------------------------------------
# MindMantra Live API - Environment Configuration Template
#--------------------------------------------------------------------

# Environment mode: production | development | testing
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP SETTINGS
#--------------------------------------------------------------------
app.baseURL = 'https://mindmantra.live/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = mindmantra
database.default.username = mindmantra_user
database.default.password = your_secure_db_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# AUTHENTICATION & SECURITY
#--------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET = your_64_character_random_hex_secret_key
